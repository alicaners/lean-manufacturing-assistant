# Copy this file to .env and change the passwords. Never commit .env.

POSTGRES_USER=lean
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=lean_assistant

REDIS_PASSWORD=change-me-redis
# Change only if port 6379 is already used on your machine (e.g. by another Redis).
REDIS_HOST_PORT=6379

# MinIO password must be at least 8 characters.
MINIO_ROOT_USER=lean-minio
MINIO_ROOT_PASSWORD=change-me-minio

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me-pgadmin